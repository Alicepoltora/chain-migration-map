[Unit]
Description=Chain Migration Map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/chain-migration-map
EnvironmentFile=-/opt/chain-migration-map/.env
ExecStart=/usr/local/bin/node /opt/chain-migration-map/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
